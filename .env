# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=secret

DATABASE_URL=postgresql://postgres:secret@db:5432/appdb

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0